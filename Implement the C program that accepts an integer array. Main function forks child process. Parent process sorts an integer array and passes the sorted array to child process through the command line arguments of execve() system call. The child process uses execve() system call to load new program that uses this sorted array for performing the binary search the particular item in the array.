Q.1. Implement the C program that accepts an integer array. Main function forks
child process. Parent process sorts an integer array and passes the sorted array
to child process through the command line arguments of execve() system call.
The child process uses execve() system call to load new program that uses this
sorted array for performing the binary search the particular item in the array.
[15 Marks]

Program Title: execve() with Binary Search

#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

void bubbleSort(int a[], int n) {
    for (int i = 0; i < n - 1; i++)
        for (int j = 0; j < n - i - 1; j++)
            if (a[j] > a[j + 1]) {
                int temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
}

int main(int argc, char *argv[]) {
    if (argc > 1 && argv[1][0] == 'c') {
        int n = atoi(argv[2]);

        printf("Sorted Array: ");
        for (int i = 0; i < n; i++)
            printf("%s ", argv[i + 3]);

        int key;
        printf("\nEnter item to search: ");
        scanf("%d", &key);

        int low = 0, high = n - 1, mid;
        int found = 0;

        while (low <= high) {
            mid = (low + high) / 2;
            int value = atoi(argv[mid + 3]);

            if (value == key) {
                found = 1;
                break;
            } else if (value < key)
                low = mid + 1;
            else
                high = mid - 1;
        }

        if (found)
            printf("Item found at position %d\n", mid + 1);
        else
            printf("Item not found\n");

        return 0;
    }

    int n;
    printf("Enter number of integers: ");
    scanf("%d", &n);

    int a[50];
    printf("Enter integers:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    bubbleSort(a, n);

    pid_t pid = fork();

    if (pid < 0) {
        printf("Fork failed\n");
        return 1;
    }

    if (pid == 0) {
        char *args[55];

        args[0] = "./a.out";
        args[1] = "child";

        char size[10];
        sprintf(size, "%d", n);
        args[2] = size;

        char numbers[50][20];

        for (int i = 0; i < n; i++) {
            sprintf(numbers[i], "%d", a[i]);
            args[i + 3] = numbers[i];
        }

        args[n + 3] = NULL;

        execve(args[0], args, NULL);
        perror("execve failed");
    } else {
        wait(NULL);
        printf("Parent process completed.\n");
    }

    return 0;
}

Q.2

Write the simulation program for demand paging and show the page scheduling
and total number of page faults according the FIFO page replacement
algorithm. Assume the memory of n frames.
Reference String: 3, 4, 5, 6, 3, 4, 7, 3, 4, 5, 6, 7, 2, 4, 6 [15 Marks]

Program Title: FIFO Page Replacement

#include <stdio.h>

int main() {
    int ref[] = {3, 4, 5, 6, 3, 4, 7, 3,
                 4, 5, 6, 7, 2, 4, 6};

    int total = 15;
    int frames[20];
    int n, pointer = 0, faults = 0;

    printf("Enter number of frames: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++)
        frames[i] = -1;

    printf("\nPage\tFrames\t\tStatus\n");

    for (int i = 0; i < total; i++) {
        int page = ref[i];
        int found = 0;

        for (int j = 0; j < n; j++) {
            if (frames[j] == page) {
                found = 1;
                break;
            }
        }

        if (!found) {
            frames[pointer] = page;
            pointer = (pointer + 1) % n;
            faults++;
        }

        printf("%d\t", page);

        for (int j = 0; j < n; j++)
            printf("%d ", frames[j]);

        if (found)
            printf("\tHit\n");
        else
            printf("\tPage Fault\n");
    }

    printf("\nTotal number of page faults = %d\n", faults);

    return 0;
}

