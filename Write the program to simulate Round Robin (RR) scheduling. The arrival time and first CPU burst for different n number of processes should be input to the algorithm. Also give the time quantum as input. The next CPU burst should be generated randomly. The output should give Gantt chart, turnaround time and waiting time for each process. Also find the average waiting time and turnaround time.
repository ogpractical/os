Q.1

Write the program to simulate Round Robin (RR) scheduling. The arrival
time and first CPU burst for different n number of processes should be
input to the algorithm. Also give the time quantum as input. The next CPU
burst should be generated randomly. The output should give Gantt chart,
turnaround time and waiting time for each process. Also find the average
waiting time and turnaround time. [15Marks]

Program Title: Round Robin (RR) Scheduling

#include <stdio.h>
#include <stdlib.h>

struct Process {
    int pid, at, bt, rt, ct, tat, wt;
};

int main() {
    int n, tq, time = 0, completed = 0;
    struct Process p[20];
    int queue[100], front = 0, rear = 0, visited[20] = {0};

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("Enter arrival time and CPU burst for P%d: ", i + 1);
        scanf("%d%d", &p[i].at, &p[i].bt);
        p[i].rt = p[i].bt;
    }

    printf("Enter Time Quantum: ");
    scanf("%d", &tq);

    printf("\nGantt Chart:\n");

    queue[rear++] = 0;
    visited[0] = 1;

    while (completed < n) {
        if (front == rear) {
            time++;
            for (int i = 0; i < n; i++) {
                if (!visited[i] && p[i].at <= time) {
                    queue[rear++] = i;
                    visited[i] = 1;
                }
            }
            continue;
        }

        int i = queue[front++];
        int exec = (p[i].rt < tq) ? p[i].rt : tq;

        printf("| P%d ", p[i].pid);
        time += exec;
        p[i].rt -= exec;

        for (int j = 0; j < n; j++) {
            if (!visited[j] && p[j].at <= time) {
                queue[rear++] = j;
                visited[j] = 1;
            }
        }

        if (p[i].rt > 0)
            queue[rear++] = i;
        else {
            p[i].ct = time;
            p[i].tat = p[i].ct - p[i].at;
            p[i].wt = p[i].tat - p[i].bt;
            completed++;
        }
    }

    printf("|\n\n");

    float avgWT = 0, avgTAT = 0;

    printf("PID\tAT\tBT\tCT\tTAT\tWT\n");
    for (int i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n",
               p[i].pid, p[i].at, p[i].bt,
               p[i].ct, p[i].tat, p[i].wt);

        avgWT += p[i].wt;
        avgTAT += p[i].tat;
    }

    printf("\nAverage Waiting Time = %.2f", avgWT / n);
    printf("\nAverage Turnaround Time = %.2f\n", avgTAT / n);

    return 0;
}

Q.2

Write a simulation program for disk scheduling using Look
algorithm. Accept total number of disk blocks, disk request string,
and current head position from the user. Display the list of request in
the order in which it is served. Also display the total number of head
moments. 55, 58, 39, 18, 90, 160, 150, 38.
Start Head Position: 100
Direction: Left [15 Marks]

Program Title: LOOK Disk Scheduling

#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, head, i, j, total = 0;
    int req[50], temp;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);

    printf("Enter number of disk requests: ");
    scanf("%d", &j);

    printf("Enter disk request string:\n");
    for (i = 0; i < j; i++)
        scanf("%d", &req[i]);

    printf("Enter current head position: ");
    scanf("%d", &head);

    /* Sort requests */
    for (i = 0; i < j - 1; i++) {
        for (int k = i + 1; k < j; k++) {
            if (req[i] > req[k]) {
                temp = req[i];
                req[i] = req[k];
                req[k] = temp;
            }
        }
    }

    printf("\nOrder of service:\n");

    /* Direction: Left */
    for (i = j - 1; i >= 0; i--) {
        if (req[i] <= head) {
            printf("%d ", req[i]);
            total += abs(head - req[i]);
            head = req[i];
        }
    }

    /* Then move right */
    for (i = 0; i < j; i++) {
        if (req[i] > head) {
            printf("%d ", req[i]);
            total += abs(head - req[i]);
            head = req[i];
        }
    }

    printf("\nTotal number of head movements = %d\n", total);

    return 0;
}

