Q.1

Q.1 Implement the Menu driven Banker's algorithm for accepting Allocation,
Max from user
a) Accept Available
b) Display Allocation, Max
c) Find Need and display It,
d)Display Available
** Consider the system with 3 resources types A, B, and C with 7, 2, 6 instances
respectively consider the following snapshot:**
Process Allocation Request
A B C A B C
P0 0 1 0 0 0 0
P1 4 0 0 5 2 2
P2 5 0 4 1 0 4
P3 4 3 3 4 4 4
P4 2 2 4 6 5 5
** [15 Marks]**

Program Title: Banker's Algorithm

#include <stdio.h>

#define P 5
#define R 3

int allocation[P][R] = {
    {0, 1, 0},
    {4, 0, 0},
    {5, 0, 4},
    {4, 3, 3},
    {2, 2, 4}
};

int max[P][R] = {
    {0, 0, 0},
    {5, 2, 2},
    {1, 0, 4},
    {4, 4, 4},
    {6, 5, 5}
};

int available[R];
int need[P][R];

void calculateNeed()
{
    int i, j;

    for(i = 0; i < P; i++)
        for(j = 0; j < R; j++)
            need[i][j] = max[i][j] - allocation[i][j];
}

void displayAllocationMax()
{
    int i, j;

    printf("\nAllocation Matrix:\n");

    for(i = 0; i < P; i++)
    {
        for(j = 0; j < R; j++)
            printf("%d ", allocation[i][j]);

        printf("\n");
    }

    printf("\nMax Matrix:\n");

    for(i = 0; i < P; i++)
    {
        for(j = 0; j < R; j++)
            printf("%d ", max[i][j]);

        printf("\n");
    }
}

void displayNeed()
{
    int i, j;

    calculateNeed();

    printf("\nNeed Matrix:\n");

    for(i = 0; i < P; i++)
    {
        for(j = 0; j < R; j++)
            printf("%d ", need[i][j]);

        printf("\n");
    }
}

void displayAvailable()
{
    int i;

    printf("\nAvailable:\n");

    for(i = 0; i < R; i++)
        printf("%d ", available[i]);

    printf("\n");
}

int main()
{
    int choice, i;

    do
    {
        printf("\n--- BANKER'S ALGORITHM ---");
        printf("\n1. Accept Available");
        printf("\n2. Display Allocation, Max");
        printf("\n3. Find Need and display It");
        printf("\n4. Display Available");
        printf("\n5. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter Available resources A B C: ");

                for(i = 0; i < R; i++)
                    scanf("%d", &available[i]);

                break;

            case 2:
                displayAllocationMax();
                break;

            case 3:
                displayNeed();
                break;

            case 4:
                displayAvailable();
                break;

            case 5:
                printf("Exit\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    } while(choice != 5);

    return 0;
}


