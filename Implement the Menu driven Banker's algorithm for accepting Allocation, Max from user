Q.2

Q.2 Write a simulation program for disk scheduling using SCAN algorithm.
Accept total Number of disk blocks, disk request string, and current
head position from the user. Display the list of requests in the
order in which it is served. Also display the total number of head moments.
** 82, 170, 43, 140, 24, 16, 190, 65**
** Starting Head position= 50**
** Direction: Left**
** [15 Marks ]**

Program Title: SCAN Disk Scheduling

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i, head, total = 0;
    int request[100];
    int left[100], right[100];
    int l = 0, r = 0;

    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);

    printf("Enter number of requests: ");
    scanf("%d", &i);

    printf("Enter disk request string:\n");

    for(int j = 0; j < i; j++)
        scanf("%d", &request[j]);

    printf("Enter current head position: ");
    scanf("%d", &head);

    for(int j = 0; j < i; j++)
    {
        if(request[j] < head)
            left[l++] = request[j];
        else
            right[r++] = request[j];
    }

    for(int j = 0; j < l - 1; j++)
    {
        for(int k = j + 1; k < l; k++)
        {
            if(left[j] < left[k])
            {
                int temp = left[j];
                left[j] = left[k];
                left[k] = temp;
            }
        }
    }

    for(int j = 0; j < r - 1; j++)
    {
        for(int k = j + 1; k < r; k++)
        {
            if(right[j] > right[k])
            {
                int temp = right[j];
                right[j] = right[k];
                right[k] = temp;
            }
        }
    }

    printf("\nOrder of service:\n");

    for(int j = 0; j < l; j++)
    {
        printf("%d ", left[j]);
        total += abs(head - left[j]);
        head = left[j];
    }

    if(l > 0)
    {
        total += head;
        head = 0;
    }

    for(int j = 0; j < r; j++)
    {
        printf("%d ", right[j]);
        total += abs(head - right[j]);
        head = right[j];
    }

    printf("\nTotal head movements = %d\n", total);

    return 0;
}

