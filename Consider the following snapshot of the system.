Using Resource –Request algorithm to Check whether the current system is in
safe state or not [15 Marks]

Program Title: Resource Request Algorithm

#include <stdio.h>

#define P 5
#define R 4

int main()
{
    int allocation[P][R] = {
        {2, 0, 0, 1},
        {3, 1, 2, 1},
        {2, 1, 0, 3},
        {1, 3, 1, 2},
        {1, 4, 3, 2}
    };

    int max[P][R] = {
        {4, 2, 1, 2},
        {5, 2, 5, 2},
        {2, 3, 1, 6},
        {1, 4, 2, 4},
        {3, 6, 6, 5}
    };

    int available[R] = {3, 3, 2, 1};
    int need[P][R];
    int finish[P] = {0};
    int safe[P];

    int i, j, k, count = 0;

    for(i = 0; i < P; i++)
    {
        for(j = 0; j < R; j++)
        {
            need[i][j] = max[i][j] - allocation[i][j];
        }
    }

    printf("Need Matrix:\n");

    for(i = 0; i < P; i++)
    {
        for(j = 0; j < R; j++)
            printf("%d ", need[i][j]);

        printf("\n");
    }

    while(count < P)
    {
        int found = 0;

        for(i = 0; i < P; i++)
        {
            if(finish[i] == 0)
            {
                int possible = 1;

                for(j = 0; j < R; j++)
                {
                    if(need[i][j] > available[j])
                    {
                        possible = 0;
                        break;
                    }
                }

                if(possible)
                {
                    for(k = 0; k < R; k++)
                        available[k] += allocation[i][k];

                    safe[count++] = i;
                    finish[i] = 1;
                    found = 1;
                }
            }
        }

        if(found == 0)
            break;
    }

    if(count == P)
    {
        printf("\nSystem is in SAFE state.\n");
        printf("Safe Sequence: ");

        for(i = 0; i < P; i++)
            printf("P%d ", safe[i]);

        printf("\n");
    }
    else
    {
        printf("\nSystem is NOT in safe state.\n");
    }

    return 0;
}


