Q.1

Q.1. Write a program to simulate Sequential file allocation method. Assume disk with
n number of blocks. Give value of n as input. Randomly mark some block as
allocated and accordingly maintain the list of free blocks Write menu driver
program with menu options as mentioned below and implement each option.
 Show Bit Vector
 Create New File
 Show Directory
 Exit [15 Marks]

Program Title: Sequential File Allocation

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct File
{
    char name[20];
    int start;
    int length;
};

int main()
{
    int n, i, choice, start, length;
    int blocks[100];
    struct File files[50];
    int fileCount = 0;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
        blocks[i] = rand() % 2;

    do
    {
        printf("\n1. Show Bit Vector");
        printf("\n2. Create New File");
        printf("\n3. Show Directory");
        printf("\n4. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("\nBit Vector:\n");

                for(i = 0; i < n; i++)
                    printf("%d ", blocks[i]);

                printf("\n");
                break;

            case 2:
                printf("Enter file name: ");
                scanf("%s", files[fileCount].name);

                printf("Enter starting block: ");
                scanf("%d", &start);

                printf("Enter length: ");
                scanf("%d", &length);

                if(start + length > n)
                {
                    printf("File cannot be allocated.\n");
                    break;
                }

                for(i = start; i < start + length; i++)
                {
                    if(blocks[i] == 1)
                    {
                        printf("Blocks are already allocated.\n");
                        break;
                    }
                }

                if(i == start + length)
                {
                    for(i = start; i < start + length; i++)
                        blocks[i] = 1;

                    files[fileCount].start = start;
                    files[fileCount].length = length;
                    fileCount++;

                    printf("File allocated successfully.\n");
                }

                break;

            case 3:
                printf("\nFile Name\tStart\tLength\n");

                for(i = 0; i < fileCount; i++)
                {
                    printf("%s\t\t%d\t%d\n",
                           files[i].name,
                           files[i].start,
                           files[i].length);
                }

                break;

            case 4:
                printf("Exit\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    } while(choice != 4);

    return 0;
}


