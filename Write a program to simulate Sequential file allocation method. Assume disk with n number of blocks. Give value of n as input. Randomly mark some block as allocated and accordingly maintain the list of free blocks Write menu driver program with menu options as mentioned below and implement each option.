Q.2

Q.2 Write a simulation program for disk scheduling using C-SCAN algorithm.
Accept total number of disk blocks, disk request string, and current head position
from the user. Display the list of requests in the order in which it is served.
also display the total number of head movements (Assume disk size=200)
15, 45, 75, 105, 135, 165, 195, 80
Starting Head Position: 100
Direction: Right
[15 Marks]

Program Title: C-SCAN Disk Scheduling

#include <stdio.h>
#include <stdlib.h>

int main()
{
    int request[] = {15, 45, 75, 105, 135, 165, 195, 80};
    int n = 8;
    int head = 100;
    int diskSize = 200;
    int right[100], left[100];
    int r = 0, l = 0;
    int i, j, total = 0;

    for(i = 0; i < n; i++)
    {
        if(request[i] >= head)
            right[r++] = request[i];
        else
            left[l++] = request[i];
    }

    for(i = 0; i < r - 1; i++)
    {
        for(j = i + 1; j < r; j++)
        {
            if(right[i] > right[j])
            {
                int temp = right[i];
                right[i] = right[j];
                right[j] = temp;
            }
        }
    }

    for(i = 0; i < l - 1; i++)
    {
        for(j = i + 1; j < l; j++)
        {
            if(left[i] > left[j])
            {
                int temp = left[i];
                left[i] = left[j];
                left[j] = temp;
            }
        }
    }

    printf("Order of service:\n");

    for(i = 0; i < r; i++)
    {
        printf("%d ", right[i]);
        total += abs(head - right[i]);
        head = right[i];
    }

    total += (diskSize - 1 - head);
    head = diskSize - 1;

    total += diskSize - 1;
    head = 0;

    for(i = 0; i < l; i++)
    {
        printf("%d ", left[i]);
        total += abs(head - left[i]);
        head = left[i];
    }

    printf("\nTotal head movements = %d\n", total);

    return 0;
}


