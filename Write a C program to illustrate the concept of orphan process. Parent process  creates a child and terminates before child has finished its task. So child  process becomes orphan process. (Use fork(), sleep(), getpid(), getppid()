Q.1 Write a C program to illustrate the concept of orphan process. Parent process
 creates a child and terminates before child has finished its task. So child
 process becomes orphan process. (Use fork(), sleep(), getpid(), getppid()
 
 #include <stdio.h>
#include <unistd.h>
#include <stdlib.h>

int main()
{
    int pid;

    pid = fork();

    if(pid < 0)
    {
        printf("Fork failed\n");
    }
    else if(pid == 0)
    {
        printf("Child Process\n");
        printf("Child PID = %d\n", getpid());
        printf("Parent PID = %d\n", getppid());

        sleep(5);

        printf("\nAfter parent terminates:\n");
        printf("Child PID = %d\n", getpid());
        printf("New Parent PID = %d\n", getppid());
    }
    else
    {
        printf("Parent Process\n");
        printf("Parent PID = %d\n", getpid());

        sleep(2);

        printf("Parent process terminated.\n");
        exit(0);
    }

    return 0;
}
 
 
 Q.2 Write a C program that behaves like a shell which displays the command
 prompt ‘$’. It accepts the command, tokenize the command line and
 execute it by creating the child process. Also implement the additional
 command ‘search’ as
a. $ search f filename pattern : It will search the first occurrence of
pattern in the given file
b. $ search a filename pattern : It will search all the occurrence of
 pattern in the given file
c. $ search c filename pattern : It will count the number of occurrence
 of pattern in the given file
 
#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <string.h>
#include <stdlib.h>

int main()
{
    char cmd[100], *arg[10];
    int i;

    while(1)
    {
        printf("$ ");
        fgets(cmd, sizeof(cmd), stdin);

        cmd[strcspn(cmd, "\n")] = '\0';

        if(strcmp(cmd, "exit") == 0)
            break;

        /* Tokenize command */
        i = 0;
        arg[i] = strtok(cmd, " ");

        while(arg[i] != NULL)
        {
            i++;
            arg[i] = strtok(NULL, " ");
        }

        /* Search command */
        if(strcmp(arg[0], "search") == 0)
        {
            FILE *fp;
            char line[200];
            int count = 0;
            char *p;

            fp = fopen(arg[2], "r");

            if(fp == NULL)
            {
                printf("File not found\n");
                continue;
            }

            /* Search first occurrence */
            if(arg[1][0] == 'f')
            {
                while(fgets(line, sizeof(line), fp))
                {
                    p = strstr(line, arg[3]);

                    if(p != NULL)
                    {
                        printf("Pattern found: %s", line);
                        break;
                    }
                }
            }

            /* Search all occurrences */
            else if(arg[1][0] == 'a')
            {
                while(fgets(line, sizeof(line), fp))
                {
                    p = line;

                    while((p = strstr(p, arg[3])) != NULL)
                    {
                        count++;
                        printf("Occurrence %d found\n", count);
                        p++;
                    }
                }

                if(count == 0)
                    printf("Pattern not found\n");
            }

            /* Count occurrences */
            else if(arg[1][0] == 'c')
            {
                while(fgets(line, sizeof(line), fp))
                {
                    p = line;

                    while((p = strstr(p, arg[3])) != NULL)
                    {
                        count++;
                        p++;
                    }
                }

                printf("Number of occurrences = %d\n", count);
            }

            else
                printf("Invalid search option\n");

            fclose(fp);
        }

        /* Normal shell command */
        else
        {
            int pid = fork();

            if(pid == 0)
            {
                execvp(arg[0], arg);
                printf("Command not found\n");
                exit(1);
            }
            else
            {
                wait(NULL);
            }
        }
    }

    return 0;
}
