Q.1

Write the simulation program to implement demand paging and show the page
scheduling and total number of page faults according to the LRU
(using counter method) page replacement algorithm. Assume the memory of
n frames.
Reference String : 3,5,7,2,5,1,2,3,1,3,5,3,1,6,2
[15 Marks]

Program Title: LRU Page Replacement Using Counter Method

#include <stdio.h>

int main() {
    int ref[] = {3,5,7,2,5,1,2,3,1,3,5,3,1,6,2};
    int total = 15, n;
    int frames[20], counter[20];
    int faults = 0, time = 0;

    printf("Enter number of frames: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        frames[i] = -1;
        counter[i] = 0;
    }

    printf("\nPage\tFrames\t\tStatus\n");

    for (int i = 0; i < total; i++) {
        int page = ref[i];
        int found = -1;

        time++;

        for (int j = 0; j < n; j++) {
            if (frames[j] == page) {
                found = j;
                break;
            }
        }

        if (found != -1) {
            counter[found] = time;
            printf("%d\t", page);

            for (int j = 0; j < n; j++)
                printf("%d ", frames[j]);

            printf("\tHit\n");
        } else {
            int pos = -1;
            faults++;

            for (int j = 0; j < n; j++) {
                if (frames[j] == -1) {
                    pos = j;
                    break;
                }
            }

            if (pos == -1) {
                pos = 0;

                for (int j = 1; j < n; j++) {
                    if (counter[j] < counter[pos])
                        pos = j;
                }
            }

            frames[pos] = page;
            counter[pos] = time;

            printf("%d\t", page);

            for (int j = 0; j < n; j++)
                printf("%d ", frames[j]);

            printf("\tPage Fault\n");
        }
    }

    printf("\nTotal number of page faults = %d\n", faults);

    return 0;
}

Q.2

Write a C program that behaves like a shell which displays the command
prompt ‘$’. It accepts the command, tokenize the command line and execute it
by creating the child process. Also implement the additional command ‘count’ as
a $ count c filename: It will display the number of characters in
given file
b $ count w filename: It will display the number of words in given
file
c $ count l filename: It will display the number of lines in given file
[15 Marks]

Program Title: Shell with count Command

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/wait.h>
#include <ctype.h>

void countFile(char type, char *filename) {
    FILE *fp = fopen(filename, "r");

    if (fp == NULL) {
        perror("File");
        return;
    }

    int ch, characters = 0, words = 0, lines = 0;
    int inWord = 0;

    while ((ch = fgetc(fp)) != EOF) {
        characters++;

        if (ch == '\n')
            lines++;

        if (isspace(ch))
            inWord = 0;
        else if (!inWord) {
            words++;
            inWord = 1;
        }
    }

    fclose(fp);

    if (type == 'c')
        printf("Number of characters = %d\n", characters);
    else if (type == 'w')
        printf("Number of words = %d\n", words);
    else if (type == 'l')
        printf("Number of lines = %d\n", lines);
    else
        printf("Invalid count option\n");
}

int main() {
    char command[200];
    char *args[20];

    while (1) {
        printf("$ ");
        fgets(command, sizeof(command), stdin);

        command[strcspn(command, "\n")] = '\0';

        if (strcmp(command, "exit") == 0)
            break;

        int count = 0;
        char *token = strtok(command, " ");

        while (token != NULL && count < 19) {
            args[count++] = token;
            token = strtok(NULL, " ");
        }

        args[count] = NULL;

        if (count == 0)
            continue;

        if (strcmp(args[0], "count") == 0 && count == 3) {
            countFile(args[1][0], args[2]);
            continue;
        }

        pid_t pid = fork();

        if (pid < 0) {
            perror("fork");
        } else if (pid == 0) {
            execvp(args[0], args);
            perror("Command execution failed");
            exit(1);
        } else {
            wait(NULL);
        }
    }

    return 0;
}

