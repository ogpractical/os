Q.2

Q.2 Write a program that demonstrates the use of nice () system call. After a
child process is started using fork(), assign higher priority to the child using
nice() system call. [15 Marks]

Program Title: nice () System Call

#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;

    pid = fork();

    if(pid < 0)
    {
        printf("Fork failed\n");
    }
    else if(pid == 0)
    {
        printf("Child Process\n");

        printf("Child priority before nice(): %d\n", nice(0));

        nice(-5);

        printf("Child priority after nice(): %d\n", nice(0));
    }
    else
    {
        wait(NULL);

        printf("Parent Process\n");
    }

    return 0;
}


