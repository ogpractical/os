Q.1

Q.1 Write a program to simulate Index file allocation method. Assume disk with
‘n’ number of blocks. Give value of ‘n’ as input. Randomly mark some block
as allocated and accordingly maintain the list of free blocks Write menu driven
program with menu options as mentioned above and implement each option
 Show Bit Vector
 Create New File
 Show Directory
 Exit [15 Marks ]

Program Title: Index File Allocation

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct File
{
    char name[20];
    int indexBlock;
    int blocks[50];
    int count;
};

int main()
{
    int n, i, choice, index, count;
    int bitVector[100];
    struct File files[50];
    int fileCount = 0;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
        bitVector[i] = rand() % 2;

    do
    {
        printf("\n1. Show Bit Vector");
        printf("\n2. Create New File");
        printf("\n3. Show Directory");
        printf("\n4. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("\nBit Vector:\n");

                for(i = 0; i < n; i++)
                    printf("%d ", bitVector[i]);

                printf("\n");
                break;

            case 2:
                printf("Enter file name: ");
                scanf("%s", files[fileCount].name);

                printf("Enter index block: ");
                scanf("%d", &index);

                if(index < 0 || index >= n || bitVector[index] == 1)
                {
                    printf("Index block is not available.\n");
                    break;
                }

                bitVector[index] = 1;
                files[fileCount].indexBlock = index;

                printf("Enter number of blocks required: ");
                scanf("%d", &count);

                files[fileCount].count = 0;

                for(i = 0; i < n && files[fileCount].count < count; i++)
                {
                    if(bitVector[i] == 0)
                    {
                        bitVector[i] = 1;
                        files[fileCount].blocks[
                            files[fileCount].count++] = i;
                    }
                }

                if(files[fileCount].count == count)
                {
                    printf("File allocated successfully.\n");
                    fileCount++;
                }
                else
                {
                    printf("Not enough free blocks.\n");
                }

                break;

            case 3:
                printf("\nFile Name\tIndex Block\tBlocks\n");

                for(i = 0; i < fileCount; i++)
                {
                    int j;

                    printf("%s\t\t%d\t\t",
                           files[i].name,
                           files[i].indexBlock);

                    for(j = 0; j < files[i].count; j++)
                        printf("%d ", files[i].blocks[j]);

                    printf("\n");
                }

                break;

            case 4:
                printf("Exit\n");
                break;

            default:
                printf("Invalid choice\n");
        }

    } while(choice != 4);

    return 0;
}


